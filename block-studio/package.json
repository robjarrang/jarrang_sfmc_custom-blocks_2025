{
  "name": "jarrang-block-studio",
  "version": "1.25.8",
  "private": true,
  "scripts": {
    "build": "python3 build.py",
    "test": "node scripts/validate.cjs",
    "format": "prettier --write 'src/*.{js,css}' 'tests/*.cjs' 'scripts/*.cjs' index.html",
    "format:check": "prettier --check 'src/*.{js,css}' 'tests/*.cjs' 'scripts/*.cjs' index.html",
    "test:browser": "node tests/browser-regressions.cjs",
    "check:size": "node scripts/check-size.cjs"
  },
  "devDependencies": {
    "happy-dom": "20.14.6",
    "prettier": "3.9.9"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 100
  }
}
