      "source": "<!-- START .esc-checklist --><table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"content-outer esc-checklist\" role=\"presentation\" style=\"background-color: #ffffff; width: 620px;\">\n \n  <tr>\n   <td class=\"side\" style=\"width: 20px;\">\n    &nbsp;</td><td class=\"content-inner\" style=\"padding: 30px 0; width: 580px;\" valign=\"top\">\n    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"sect\" role=\"presentation\" style=\"width: 100%;\" width=\"100%\">\n     \n      <tr>\n       <td style=\"width: 100%;\">\n        <p style=\"color: #878787; font-family: 'enra-slab-variable', Rockwell, Arial, Helvetica, sans-serif !important; font-size: 11px; font-weight: 700; letter-spacing: 1.5px; line-height: 16px; margin: 0 0 8px; text-transform: uppercase;\">\n         Webinar</p><h2 class=\"dark-invert\" style=\"color: #1a1a1a; font-family: 'enra-slab-variable', Rockwell, Arial, Helvetica, sans-serif !important; font-size: 22px; font-weight: 700; line-height: 28px; margin: 0 0 10px;\">\n         Learning objectives</h2><div style=\"background-color: %%=v(@PrimaryColour)=%%; font-size: 1px; height: 3px; line-height: 1px; width: 40px;\">\n         &nbsp;</div></td></tr><tr>\n       <td style=\"padding-top: 20px; width: 100%;\">\n        <p class=\"dark-body\" style=\"color: #333333; font-family: 'mulish-variable', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif !important; font-size: 15px; line-height: 24px; margin: 0 0 16px;\">\n         After watching this webinar, participants will be able to:</p>{% for item in items %}<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"margin-bottom: 12px;\" width=\"100%\">\n         \n          <tr>\n           <td style=\"padding-right: 10px; width: 28px;\" valign=\"top\" width=\"28\">\n            <div style=\"background-color: %%=v(@PrimaryColour)=%%; border-radius: 50%; color: %%=v(@TextOnPri