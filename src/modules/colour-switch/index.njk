set @colourOneSwatchColour = "#ffffff"
set @colourOneAltText = "BOLT 100 white safety helmet"
set @colourOneLabel = "White"
set @colourOneLink = "https://www.milwaukeetool.eu/en-eu/bolt-100/bolt-100/?variant=1012572"

/* Option 2 */
set @colourTwoImage = "https://static.milwaukeetool.eu/remote.axd/milwaukee-media-images.s3.amazonaws.com/hi/4932478913--Hero_1.png"
