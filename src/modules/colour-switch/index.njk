<textarea id="html" style="width:100%;height:90vh;"><!-- Colour Switch module source is generated from this custom block. Use @thumbnailStyle = "swatches" for colour circles or "images" for image thumbnails. -->
%%[
/* ============================================================
   COLOUR / THUMBNAIL IMAGE SWAP MODULE SETTINGS
   Edit values in this section only.
   ============================================================ */
set @moduleName = "bolt-100-colour-swap-01"
