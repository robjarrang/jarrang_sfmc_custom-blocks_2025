set @colourTenThumbnailImage = ""
set @colourTenSwatchColour = "#999999"
set @colourTenAltText = "BOLT 100 placeholder option 10"
set @colourTenLabel = "Option 10"
set @colourTenLink = ""

/* ============================================================
   MODULE LOGIC
   No edits needed below this line.
   ============================================================ */
set @moduleName = Replace(Lowercase(Trim(@moduleName)), " ", "-")
set @moduleClass = Concat("mwk-", @moduleName, "-interactive")
set @thumbnailStyle = Lowercase(Trim(@thumbnailStyle))
if @thumbnailStyle != "images" then set @thumbnailStyle = "swatches" endif
if Empty(@numberOfColourOptions) then set @numberOfColourOptions = 1 endif
if @numberOfColourOptions < 1 then set @numberOfColourOptions = 1 elseif @numberOfColourOptions > 10 then set @numberOfColourOptions = 10 endif
if Empty(@coloursPerRow) then set @coloursPerRow = 4 endif
if @coloursPerRow < 1 then set @coloursPerRow = 1 elseif @coloursPerRow > 5 then set @coloursPerRow = 5 endif
set @backgroundColour = Lowercase(Trim(@backgroundColour))
if @backgroundColour == "red" then set @backgroundColourHex = "#B50018" set @selectedRingColour = "#ffffff" elseif @backgroundColour == "white" then set @backgroundColourHex = "#ffffff" set @selectedRingColour = "#000000" else set @backgroundColourHex = "#000000" set @selectedRingColour = "#ffffff" endif
if @backgroundColour == "black" then set @buttonClass = "button-2-white button-mobile-center" set @buttonTableStyle = "background-color: transparent; border: 2px solid #ffffff; border-collapse: separate; border-radius: 4px !important;" set @buttonTextColour = "#ffffff" else set @buttonClass = "button-1-black button-mobile-center" set @buttonTableStyle = "background-color: #000000; border-radius: 4px !important;" set @buttonTextColour = "#ffffff" endif
