set @optionLabels = Concat(@colourOneLabel,"|",@colourTwoLabel,"|",@colourThreeLabel,"|",@colourFourLabel,"|",@colourFiveLabel,"|",@colourSixLabel,"|",@colourSevenLabel,"|",@colourEightLabel,"|",@colourNineLabel,"|",@colourTenLabel)
set @optionLinks = Concat(Iif(Empty(Trim(@colourOneLink)),@productPageLink,@colourOneLink),"|",Iif(Empty(Trim(@colourTwoLink)),@productPageLink,@colourTwoLink),"|",Iif(Empty(Trim(@colourThreeLink)),@productPageLink,@colourThreeLink),"|",Iif(Empty(Trim(@colourFourLink)),@productPageLink,@colourFourLink),"|",Iif(Empty(Trim(@colourFiveLink)),@productPageLink,@colourFiveLink),"|",Iif(Empty(Trim(@colourSixLink)),@productPageLink,@colourSixLink),"|",Iif(Empty(Trim(@colourSevenLink)),@productPageLink,@colourSevenLink),"|",Iif(Empty(Trim(@colourEightLink)),@productPageLink,@colourEightLink),"|",Iif(Empty(Trim(@colourNineLink)),@productPageLink,@colourNineLink),"|",Iif(Empty(Trim(@colourTenLink)),@productPageLink,@colourTenLink))
set @optionImageRows = BuildRowsetFromString(@optionImages, "|")
set @optionThumbnailImageRows = BuildRowsetFromString(@optionThumbnailImages, "|")
set @optionSwatchColourRows = BuildRowsetFromString(@optionSwatchColours, "|")
set @optionAltTextRows = BuildRowsetFromString(@optionAltTexts, "|")
set @optionLabelRows = BuildRowsetFromString(@optionLabels, "|")
set @optionLinkRows = BuildRowsetFromString(@optionLinks, "|")
set @imageWidth = "580"
