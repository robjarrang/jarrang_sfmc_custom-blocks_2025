set @colourFiveThumbnailImage = ""
set @colourFiveSwatchColour = "#db011c"
set @colourFiveAltText = "BOLT 100 red safety helmet"
set @colourFiveLabel = "Red"
set @colourFiveLink = ""

/* Option 6 */
