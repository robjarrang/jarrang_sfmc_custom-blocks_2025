set @colourSixThumbnailImage = ""
set @colourSixSwatchColour = "#000000"
set @colourSixAltText = "BOLT 100 black safety helmet"
set @colourSixLabel = "Black"
set @colourSixLink = ""

/* Option 7 */
set @colourSevenImage = "https://static.milwaukeetool.eu/remote.axd/milwaukee-media-images.s3.amazonaws.com/hi/4932480663--Hero_1.png"
set @colourSevenThumbnailImage = ""
