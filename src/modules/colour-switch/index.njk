if Empty(@buttonLink) then set @buttonFinalLink = @productPageLink else set @buttonFinalLink = @buttonLink endif

set @optionImages = Concat(@colourOneImage,"|",@colourTwoImage,"|",@colourThreeImage,"|",@colourFourImage,"|",@colourFiveImage,"|",@colourSixImage,"|",@colourSevenImage,"|",@colourEightImage,"|",@colourNineImage,"|",@colourTenImage)
