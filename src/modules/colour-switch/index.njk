set @colourThreeThumbnailImage = ""
set @colourThreeSwatchColour = "#0057b8"
set @colourThreeAltText = "BOLT 100 blue safety helmet"
set @colourThreeLabel = "Blue"
set @colourThreeLink = ""

/* Option 4 */
set @colourFourImage = "https://static.milwaukeetool.eu/remote.axd/milwaukee-media-images.s3.amazonaws.com/hi/4932478915--Hero_1.png"
set @colourFourThumbnailImage = ""
set @colourFourSwatchColour = "#00843d"
set @colourFourAltText = "BOLT 100 green safety helmet"
